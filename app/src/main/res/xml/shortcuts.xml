<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon: jump straight into a new chat, a photo question or dictation. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat">
        <intent
            android:action="com.dskapp.action.NEW_CHAT"
            android:targetPackage="com.dskapp"
            android:targetClass="com.dskapp.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="camera"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_camera"
        android:shortcutShortLabel="@string/shortcut_camera"
        android:shortcutLongLabel="@string/shortcut_camera_long">
        <intent
            android:action="com.dskapp.action.CAMERA"
            android:targetPackage="com.dskapp"
            android:targetClass="com.dskapp.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="voice"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_mic"
        android:shortcutShortLabel="@string/shortcut_voice"
        android:shortcutLongLabel="@string/shortcut_voice_long">
        <intent
            android:action="com.dskapp.action.VOICE"
            android:targetPackage="com.dskapp"
            android:targetClass="com.dskapp.MainActivity" />
    </shortcut>
</shortcuts>
